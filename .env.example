# Copy to .env and fill in values. Never commit .env.
# Use a strong password for anything beyond local development.
POSTGRES_USER=trustledger
POSTGRES_PASSWORD=
POSTGRES_DB=trustledger
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- Real research agent (OpenRouter) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model used for research generation (OpenRouter format, e.g. openai/gpt-4o-mini, anthropic/claude-3.5-sonnet)
TRUSTLEDGER_MODEL=openai/gpt-4o-mini
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_TITLE=TrustLedger
# Dispatcher tick seconds (lower = faster Kanban movement)
TRUSTLEDGER_POLL=0.7
TRUSTLEDGER_DISPATCHER=1
